{
  "name": "@stamcat/react-client-template",
  "author": "Devin Marra",
  "license": "MIT",
  "version": "0.0.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stamcat/react-client-template.git"
  },
  "bugs": {
    "url": "https://github.com/Stamcat/react-client-template/issues"
  },
  "homepage": "https://github.com/Stamcat/react-client-template#readme",
  "bin": {
    "create-react-client-app": "packages/create-app/bin/create.js"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "dev:force": "vite --force",
    "lint": "eslint . && npm run lint:package && npm run lint:dependencies",
    "lint:dependencies": "dependency-cruiser --config scripts/.dependency-cruiser-check.cjs src/main.tsx src",
    "lint:dependencies:circular": "dependency-cruiser --config scripts/.dependency-cruiser-check-circular.cjs src/main.tsx src",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint ./package.json",
    "lint:sonar": "eslint . -f json -o lintreport.json",
    "pretty": "prettier --write \"src/**/*\"",
    "preview": "vite preview",
    "release": "release-it",
    "release:alpha": "release-it --preRelease=alpha",
    "release:beta": "release-it --preRelease=beta",
    "release:major": "release-it major",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch",
    "test": "jest --passWithNoTests",
    "test:bail": "jest --bail",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.8.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-redux": "9.2.0",
    "react-router-dom": "7.18.4",
    "redux-saga": "1.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.64.1",
    "@release-it/bumper": "8.0.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react-swc": "4.0.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "16.3.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "27.0.0",
    "npm-package-json-lint": "11.0.1",
    "npm-package-json-lint-config-default": "10.0.0",
    "prettier": "3.8.1",
    "release-it": "21.1.3",
    "ts-jest": "29.4.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.7"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
